<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MobUK" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mob_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MobUK.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mob_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MobUK</item>
    </style>
</resources>
